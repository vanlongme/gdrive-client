{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
    "target": "ES2023",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "@cloudflare/vitest-plugin/types",
      "vite/client"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true
  },
  "include": [
    "src/worker",
    "src/shared",
    "src/db",
    "tests/unit",
    "tests/integration",
    "tests/fixtures",
    "worker-configuration.d.ts"
  ],
  // HLS fixtures use the MPEG-TS ".ts" extension for binary media segments;
  // they are data, not TypeScript.
  "exclude": ["tests/fixtures/hls/**/*.ts"]
}
